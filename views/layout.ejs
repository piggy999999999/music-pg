<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - Music Player</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <div class="app-container">
        <!-- Боковое меню -->
        <nav class="sidebar">
            <h2>🎵 Music App</h2>
            <ul>
                <li><a href="/" class="nav-link <%= activePage === 'home' ? 'active' : '' %>">Главная</a></li>
                <li><a href="/search" class="nav-link <%= activePage === 'search' ? 'active' : '' %>">Поиск</a></li>
                <li><a href="/albums" class="nav-link <%= activePage === 'albums' ? 'active' : '' %>">Альбомы</a></li>
                <li><a href="/upload" class="nav-link <%= activePage === 'upload' ? 'active' : '' %>">Загрузка</a></li>
            </ul>
        </nav>
        
        <!-- Основной контент -->
        <main class="main-content">
            <%- body %>
        </main>
    </div>
    
    <!-- Плеер -->
    <div class="player-bar">
        <div class="player-controls">
            <button id="prev-btn">⏮</button>
            <button id="play-btn">▶️</button>
            <button id="next-btn">⏭</button>
        </div>
        <div class="player-progress">
            <span id="current-time">0:00</span>
            <input type="range" id="progress-bar" min="0" max="100" value="0">
            <span id="total-time">0:00</span>
        </div>
        <div class="volume-control">
            <span>🔊</span>
            <input type="range" id="volume-bar" min="0" max="100" value="70">
        </div>
    </div>
    
    <script src="/app.js"></script>
</body>
</html>

<div class="section active">
    <h1>Загрузка музыки</h1>
    
    <div class="upload-container">
        <div class="upload-area" id="upload-area">
            <div class="upload-icon">🎵</div>
            <h3>Перетащите аудиофайлы сюда</h3>
            <p>MP3, M4A, FLAC, WAV, OGG</p>
            <p>или</p>
            <button class="upload-btn" id="select-files-btn">Выбрать файлы</button>
            <input type="file" id="file-input" accept=".mp3,.m4a,.aac,.flac,.wav,.ogg,.opus,audio/*" multiple hidden>
        </div>
        
        <div class="upload-progress" id="upload-progress" style="display: none;">
            <h3>Загрузка...</h3>
            <div class="progress-bar">
                <div class="progress-fill" id="progress-fill"></div>
            </div>
            <p id="upload-status"></p>
        </div>
        
        <div class="upload-results" id="upload-results"></div>
    </div>
</div>
